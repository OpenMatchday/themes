{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokens.json",
  "title": "Open Matchday theme token map v0",
  "description": "Flat token map consumed by graphics render; must include contract required keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["themes_version", "tokens"],
  "properties": {
    "themes_version": {
      "$ref": "common.json#/$defs/ThemesVersion"
    },
    "tokens": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "propertyNames": {
        "$ref": "common.json#/$defs/TokenKey"
      }
    }
  }
}
