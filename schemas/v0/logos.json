{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logos.json",
  "title": "Open Matchday theme logo slots v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["themes_version", "slots"],
  "properties": {
    "themes_version": {
      "$ref": "common.json#/$defs/ThemesVersion"
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "label", "max_width_px", "max_height_px"],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "$ref": "common.json#/$defs/NonEmptyString"
          },
          "max_width_px": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "max_height_px": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
